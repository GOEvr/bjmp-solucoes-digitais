
# ============================================================
# BJMP SOLUCOES DIGITAIS
# .htaccess - PRODUCAO
# https://www.bjmpsolucoes.com.br/
# ============================================================

# ============================================================
# 1. DESABILITAR LISTAGEM DE DIRETORIOS
# ============================================================

Options -Indexes


# ============================================================
# 2. URL CANONICA
# ============================================================

RewriteEngine On

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.bjmpsolucoes\.com\.br$ [NC]
RewriteRule ^ https://www.bjmpsolucoes.com.br%{REQUEST_URI} [R=301,L]


# ============================================================
# 3. BLOQUEAR ARQUIVOS SENSIVEIS
# ============================================================

<FilesMatch "(^\.|\.env$|\.ini$|\.log$|\.sql$|\.sqlite$|\.sqlite3$|\.bak$|\.backup$|\.old$|\.orig$|\.save$|\.swp$|\.tmp$|\.dist$|composer\.(json|lock)$|package(-lock)?\.json$)">
    Require all denied
</FilesMatch>


# ============================================================
# 4. BLOQUEAR DIRETORIOS E ARQUIVOS DE CONTROLE
# ============================================================

RewriteRule ^(?:\.git|\.github)(?:/|$) - [F,L,NC]

RewriteRule ^(?:composer\.(?:json|lock)|package(?:-lock)?\.json)$ - [F,L,NC]

RewriteRule ^(?:README|CHANGELOG|LICENSE)(?:\.[^/]+)?$ - [F,L,NC]


# ============================================================
# 5. PROTEGER O PROPRIO .HTACCESS
# ============================================================

<Files ".htaccess">
    Require all denied
</Files>


# ============================================================
# 6. PROTEGER ARQUIVOS DE CONFIGURACAO
# ============================================================

<FilesMatch "\.(?:conf|config|cfg|ini|env|dist|bak|backup|old|orig|save|swp|sql|sqlite|sqlite3|log)$">
    Require all denied
</FilesMatch>


# ============================================================
# 7. HEADERS DE SEGURANCA E AGENT DISCOVERY
# ============================================================

<IfModule mod_headers.c>

    Header always set X-Content-Type-Options "nosniff"

    Header always set X-Frame-Options "SAMEORIGIN"

    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Politica unificada
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

    # Descoberta de conteudo para agentes e ferramentas
    Header always set Link "<https://www.bjmpsolucoes.com.br/llms.txt>; rel=describedby; type=text/plain"

    Header always add Link "<https://www.bjmpsolucoes.com.br/index.md>; rel=alternate; type=text/markdown"

    # API de contato sem cache
    <Files "contact.php">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
    </Files>

</IfModule>


# ============================================================
# 8. HSTS
# ============================================================

<IfModule mod_headers.c>

    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

</IfModule>


# ============================================================
# 9. CACHE DE ARQUIVOS ESTATICOS
# ============================================================

<IfModule mod_expires.c>

    ExpiresActive On

    ExpiresByType text/html "access plus 0 seconds"

    ExpiresByType text/css "access plus 7 days"

    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"

    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"

    ExpiresByType font/woff "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType application/font-woff "access plus 30 days"
    ExpiresByType application/font-woff2 "access plus 30 days"

    ExpiresByType application/manifest+json "access plus 7 days"

    # Markdown: evitar cache prolongado durante atualizacoes
    ExpiresByType text/markdown "access plus 0 seconds"

</IfModule>


# ============================================================
# 10. CACHE-CONTROL PARA ARQUIVOS ESTATICOS
# ============================================================

<IfModule mod_headers.c>

    <FilesMatch "\.(?:css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    <FilesMatch "\.(?:md|txt)$">
        Header set Cache-Control "public, max-age=300"
    </FilesMatch>

</IfModule>


# ============================================================
# 11. NAO CACHEAR A API DE CONTATO
# ============================================================

<IfModule mod_headers.c>

    <Files "contact.php">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </Files>

</IfModule>


# ============================================================
# 12. BLOQUEAR METODOS HTTP DESNECESSARIOS
# ============================================================

<IfModule mod_rewrite.c>

    RewriteCond %{REQUEST_METHOD} ^(?:TRACE|TRACK|CONNECT)$ [NC]
    RewriteRule ^ - [F,L]

</IfModule>


# ============================================================
# 13. BLOQUEAR PASTA API EXCETO CONTACT.PHP
# ============================================================

RewriteRule ^api/(?!contact\.php$).* - [F,L,NC]


# ============================================================
# 14. IMPEDIR EXECUCAO DE ARQUIVOS NA PASTA IMG
# ============================================================

<IfModule mod_rewrite.c>

    RewriteRule ^img/.*\.(?:php|phtml|pht|phar|cgi|pl|py|sh)$ - [F,L,NC]

</IfModule>


# ============================================================
# 15. PROTEGER BACKUPS
# ============================================================

<IfModule mod_rewrite.c>

    RewriteRule \.(?:bak|backup|old|orig|save|swp|tmp)$ - [F,L,NC]

</IfModule>


# ============================================================
# 16. COMPACTACAO GZIP / DEFLATE
# ============================================================

<IfModule mod_deflate.c>

    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml

</IfModule>


# ============================================================
# 17. MIME TYPES
# ============================================================

<IfModule mod_mime.c>

    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType application/manifest+json .webmanifest
    AddType text/markdown .md

</IfModule>


# ============================================================
# 18. PAGINA 404
# ============================================================

ErrorDocument 404 /index.html


# ============================================================
# FIM DO HTACCESS
# BJMP SOLUCOES DIGITAIS
# ============================================================
